{
  "name": "friendlyai-review-action",
  "version": "1.0.2",
  "type": "commonjs",
  "private": true,
  "description": "Public GitHub Action wrapper that sends PR diffs to a private validation API and reports the returned verdict.",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts -o dist --minify --license licenses.txt",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "test": "node scripts/verify-public-surface.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vercel/ncc": "^0.38.1",
    "typescript": "^5.5.0"
  },
  "keywords": [
    "github-action",
    "code-review",
    "security",
    "pull-request",
    "validation"
  ],
  "license": "MIT",
  "author": "FriendlyAI",
  "repository": {
    "type": "git",
    "url": "https://github.com/RBKunnela/friendlyai-review-action.git"
  }
}
